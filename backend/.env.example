# Copy to backend/.env and adjust. All settings: app/config.py (prefix TSA_).

# --- QuestDB (archive) ---
TSA_QUESTDB_HOST=localhost
TSA_QUESTDB_PG_PORT=8812
TSA_QUESTDB_HTTP_PORT=9000
TSA_QUESTDB_USER=admin
TSA_QUESTDB_PASSWORD=quest
TSA_QUESTDB_DATABASE=qdb
# Basic auth for ILP over HTTP (leave empty for open-source QuestDB with default config)
TSA_QUESTDB_HTTP_USER=
TSA_QUESTDB_HTTP_PASSWORD=

# --- PostgreSQL (registry, events, alarms). docker-compose publishes it on 5433 ---
TSA_POSTGRES_DSN=postgresql+psycopg://tsa:tsa@localhost:5433/tsa

# --- Redis ---
TSA_REDIS_URL=redis://localhost:6379/0
TSA_HOT_WINDOW_S=600

# --- Aggregation grid: Delta_l = DELTA0 * BASE^l, l = 0..LEVELS-1 ---
TSA_AGG_DELTA0_MS=1000
TSA_AGG_BASE=4
TSA_AGG_LEVELS=8
TSA_TILE_BUCKETS=1024
TSA_LATE_MS=30000

# --- Selection / live ---
TSA_DETAIL_C=2.0
TSA_PRESELECT_RHO=2.0
TSA_LIVE_RATE_HZ=10

# --- Analytics defaults ---
TSA_HAMPEL_WINDOW=15
TSA_HAMPEL_KAPPA=3.0
TSA_FEATURE_WINDOW=30
TSA_RESIDUAL_K=3.0
TSA_MODELS_DIR=models

TSA_CORS_ORIGINS=["http://localhost:5173"]
